#: data/files.metainfo.xml.in.in:275 data/files.metainfo.xml.in.in:293
#: data/files.metainfo.xml.in.in:316 data/files.metainfo.xml.in.in:328
#: data/files.metainfo.xml.in.in:348
msgid "Minor updates:"
msgstr "Mindre uppdateringar:"

#: data/files.metainfo.xml.in.in:74 data/files.metainfo.xml.in.in:96
#: data/files.metainfo.xml.in.in:116 data/files.metainfo.xml.in.in:129
