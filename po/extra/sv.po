#: data/io.elementary.files.desktop.in.in:5 data/files.metainfo.xml.in.in:10
msgid "Files"
msgstr "Filer"

#: data/io.elementary.files.desktop.in.in:6
msgid "Browse your files"
msgstr "Bläddra bland dina filer"

#: data/io.elementary.files.desktop.in.in:8
msgid "folder;manager;explore;disk;filesystem;"
msgstr "mapp;hanterare;utforska;disk;filsystem;"

#: data/io.elementary.files.desktop.in.in:24
msgid "New Window"
msgstr "Nytt fönster"

#: data/io.elementary.files.desktop.in.in:29
msgid "New Window As Administrator"
msgstr "Nytt fönster som administratör"

#: data/files.metainfo.xml.in.in:11
msgid "Browse and manage files and folders"
msgstr "Bläddra igenom och hantera filer och mappar"

#: data/files.metainfo.xml.in.in:13
msgid ""
"Easily copy, move, and rename your files, or use folders to stay organized. "
"Whether you like files in lists, grids or columns, you can always find them "
"right away. Access all your files, whether locally, on an external device or "
"remotely using FTP, SFTP, AFP, Webdav, or Windows share."
msgstr ""
"Kopiera, flytta och byt namn på dina filer, eller använd mappar för att "
"organisera. Oavsett om du gillar filer i listformat, rutnät eller kolumner "
"så kan du alltid hitta dem direkt. Få tillgång till alla dina filer, lokalt, "
"på en extern lagringsenhet eller via FTP, SFTP, AFP, Webdav eller Windows-"
"utdelning."

#: data/files.metainfo.xml.in.in:18
msgid "Quick access to settings like zoom levels and hidden files"
msgstr "Snabb åtkomst till inställningar som zoomnivåer och dolda filer"

#: data/files.metainfo.xml.in.in:22
msgid "See more metadata at a glance in List view"
msgstr "Få en överblick över mer metadata i listvyn"

#: data/files.metainfo.xml.in.in:26
msgid "Browse complex trees faster with Column view"
msgstr "Bläddra bland komplexa träd snabbare med kolumnvy"

#: data/files.metainfo.xml.in.in:59
msgid "elementary, Inc."
msgstr "elementary, Inc."

#: data/files.metainfo.xml.in.in:67 data/files.metainfo.xml.in.in:85
#: data/files.metainfo.xml.in.in:122 data/files.metainfo.xml.in.in:142
#: data/files.metainfo.xml.in.in:344
msgid "Improvements:"
msgstr "Förbättringar:"

#: data/files.metainfo.xml.in.in:69
msgid ""
"Displays an informative dialog on attempting to unmount a device still in "
"use instead of crashing"
msgstr ""

#: data/files.metainfo.xml.in.in:70
msgid ""
"Shows a realistic progress rate when copy or moving data to a slow device "
"instead of cache speed"
msgstr ""

#: data/files.metainfo.xml.in.in:72 data/files.metainfo.xml.in.in:90
#: data/files.metainfo.xml.in.in:113 data/files.metainfo.xml.in.in:126
#: data/files.metainfo.xml.in.in:146 data/files.metainfo.xml.in.in:166
