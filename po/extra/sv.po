#: data/files.metainfo.xml.in.in:212 data/files.metainfo.xml.in.in:225
#: data/files.metainfo.xml.in.in:239 data/files.metainfo.xml.in.in:257
#: data/files.metainfo.xml.in.in:279 data/files.metainfo.xml.in.in:301
#: data/files.metainfo.xml.in.in:318 data/files.metainfo.xml.in.in:330
#: data/files.metainfo.xml.in.in:350
msgid "Updated translations"
msgstr "Uppdaterade översättningar"

#: data/files.metainfo.xml.in.in:87
msgid ""
"The presence of undisplayed hidden files is indicated when there are no "
"visible files"
msgstr ""

#: data/files.metainfo.xml.in.in:88
msgid ""
"Undisplayed hidden files can temporarily be shown in an otherwise empty "
"folder"
msgstr ""

#: data/files.metainfo.xml.in.in:92
msgid ""
"The existing shortcut to focus the sidebar is changed to Ctrl + Alt + Left"
msgstr ""

#: data/files.metainfo.xml.in.in:93
msgid ""
"A corresponding shortcut to focus the document is added: Ctrl + Alt + Right"
msgstr ""

#: data/files.metainfo.xml.in.in:94
msgid ""
"Shortcuts involving Left or Right arrow keys now change according whether "
"the locale is RTL or LTR"
msgstr ""

#: data/files.metainfo.xml.in.in:95
msgid "Allow horizontal scrolling in ListView to ensure all columns visible"
msgstr ""

#: data/files.metainfo.xml.in.in:115
msgid "Fixed a regression causing a crash if there are too many templates"
msgstr ""
"Rättade en regression som orsakade en krasch om det fanns för många mallar"

#: data/files.metainfo.xml.in.in:124
msgid "An option to show a preview pane in Column view is introduced"
msgstr ""
"Ett alternativ till att visa en förhandsvisningspanel i Kolumnvy introduceras"

#: data/files.metainfo.xml.in.in:128
msgid ""
"The list of search results now shows matches in the current folder first"
msgstr "Listan över sökresultat visar nu först träffar i den aktuella mappen"

#: data/files.metainfo.xml.in.in:144
msgid "A compact date format is introduced"
msgstr "Ett kompakt datumformat är introducerat"

#: data/files.metainfo.xml.in.in:148
msgid "The file conflict dialog now shows a missing icon"
msgstr "Dialogen för filkonflikt visar nu en saknad ikon"

#: data/files.metainfo.xml.in.in:149
msgid "Flickering of the pathbar with some navigation methods is fixed"
msgstr "Flimmer för sökvägsfältet med några navigeringsmetoder är fixat"

#: data/files.metainfo.xml.in.in:150
msgid "The option to set a default app for folders is no longer offered"
msgstr ""
"Alternativet att ställa in en standardapp för mappar erbjuds inte längre"

#: data/files.metainfo.xml.in.in:151
msgid "The scrollbar no longer overlays the modification date in List view"
msgstr "Rullningslisten överlägger inte längre ändringsdatum i listvyn"

#: data/files.metainfo.xml.in.in:168
msgid "Navigation within the Trash folder now works properly"
msgstr "Navigering i mappen Papperskorgen fungerar nu korrekt"

#: data/files.metainfo.xml.in.in:169
msgid "The view now refreshes properly after permanent deletion of a folder"
msgstr "Vyn uppdateras nu korrekt efter permanent borttagning av en mapp"

#: data/files.metainfo.xml.in.in:170
msgid ""
"The number of template items displayed in the context menu is now limited"
msgstr "Antalet mallobjekt som visas i snabbmenyn är nu begränsat"

#: data/files.metainfo.xml.in.in:186
msgid ""
"The Properties Window now shows the exact date and time the file was last "
"modified"
msgstr ""
"I fönstret Egenskaper visas nu exakt datum och tid för senaste ändring av "
"filen"

#: data/files.metainfo.xml.in.in:224
msgid "Further preparation for porting to Gtk4"
msgstr "Ytterligare förberedelser för portning till Gtk4"

#: data/files.metainfo.xml.in.in:255
msgid "Redesign file permissions view"
msgstr "Omarbeta vyn för filbehörigheter"

#: data/files.metainfo.xml.in.in:256
msgid "Focus sidebar by pressing Ctrl + Left"
msgstr "Fokusera sidofältet genom att trycka på Ctrl + vänster"

#: data/files.metainfo.xml.in.in:277
msgid "Restoring tabs from last time is now optional"
msgstr "Återställning av flikar från förra gången är nu valfritt"

#: data/files.metainfo.xml.in.in:278
msgid "Drag and select can no longer be done with secondary pointer button"
msgstr "Dra och välj kan inte längre göras med den sekundära pekarknappen"

#: data/files.metainfo.xml.in.in:295
msgid "Discontinue support for dragging bookmark out of sidebar"
msgstr "Avveckla stödet för att dra ut bokmärken från sidofältet"

#: data/files.metainfo.xml.in.in:296
msgid "Fix unexpected scrolling after renaming a folder"
msgstr "Fixa oväntad rullning vid namnbyte på en mapp"

#: data/files.metainfo.xml.in.in:297
msgid ""
"Fixes a crash when switching to viewing as grid under rare circumstances"
msgstr ""
"Åtgärdar en krasch vid växling till visning som rutnät under sällsynta "
"omständigheter"

#: data/files.metainfo.xml.in.in:298
msgid "Ensure the selection persists after refreshing the view"
msgstr "Se till att markeringen kvarstår efter uppdatering av vyn"

#: data/files.metainfo.xml.in.in:299
msgid "Fix Files failing to open if trying to restore a disconnected location"
msgstr ""
"Fixa att Filer inte öppnas om man försöker återställa en frånkopplad plats"

#: data/files.metainfo.xml.in.in:300
msgid "Fix the view continuing to show when a location is unmounted"
msgstr "Åtgärda att vyn fortsätter att visas när en plats avmonteras"

#: data/files.metainfo.xml.in.in:346
msgid ""
"New Tab Bar with improved animations, smoother drag-and-drop, and "
"reorganized tab context menus"
msgstr ""
"Nytt flikfält med förbättrade animationer, smidigare dra-och-släpp-funktion "
"och omorganiserade kontextmenyer för flikar"

#: data/io.elementary.files.policy.in.in:10
msgid "Run Pantheon Files as Administrator"
msgstr "Kör Pantheon Filer som administratör"

#: data/io.elementary.files.policy.in.in:11
msgid "Authentication is required to run Files as Administrator"
msgstr "Autentisering krävs för att köra programmet Filer som administratör"

